# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Everything the export writes, but not the directory: the control plane embeds
# it at compile time and has to find it in a clone that has never run a build.
/out/*
!/out/.gitkeep

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# ...except the local development default, which is not a secret and is the
# difference between `pnpm dev` working and every request 404ing from Next.
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
