# Loaded automatically by `next dev` — committed on purpose, it's the local
# default rather than a secret.
#
# In production the control plane serves the interface itself, so the API is
# same-origin and this doesn't apply. While developing they're two processes on
# two ports, so the interface has to be told where the API is.
NEXT_PUBLIC_FIRETOWER_API=http://localhost:4400
