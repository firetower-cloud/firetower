{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["../web/components/*"],
      "@/src/*": ["../web/src/*"],
      "@/app/*": ["../web/app/*"],
      "~/*": ["src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
