{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the window is allowed to do to itself. Tauri v2 denies every plugin command that is not listed here, and denies it silently \u2014 which is why dragging the title bar did nothing for four attempts, and why the dock badge never appeared.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-set-badge-count",
    "notification:default",
    "opener:default",
    "updater:default",
    "process:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit"
  ]
}
