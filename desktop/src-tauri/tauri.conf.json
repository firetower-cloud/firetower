{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firetower",
  "version": "0.8.0",
  "identifier": "cloud.firetower.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Firetower",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": "../dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 208
        },
        "applicationFolderPosition": {
          "x": 492,
          "y": 208
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQTI4OTk1RTFEMEREMEQKUldRTjNkRGhsWW1pOGV3WWVKSllDTTVjQm5QS0oxbGRUMVdPQjlEWGdCOGxSQzB3MjRVUmVBc0wK",
      "endpoints": [
        "https://github.com/firetower-cloud/firetower/releases/download/desktop-latest/latest.json"
      ]
    }
  }
}
