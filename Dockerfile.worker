# A worker, built for Linux.
#
# It builds the binary rather than copying one in: the host you develop on is
# probably macOS, and a Mach-O executable in a Linux container fails with
# `exec format error` at the least helpful possible moment.
#
# No sshd. A container here is reached with `docker exec`, and a container on a
# server is reached by ssh-ing to that machine and running `docker exec` there.
# Either way there is no daemon, no key inside the image, no published port, and
# no host key that changes every time the container is recreated.

# Cross-compiled, not emulated. `--platform=$BUILDPLATFORM` pins this stage to
# the machine doing the building, so an arm64 image is compiled at full speed on
# an amd64 runner rather than instruction-by-instruction under QEMU.
FROM --platform=$BUILDPLATFORM rust:1-bookworm AS build
WORKDIR /src

# Both set by buildx: what we are running on, and what we are building for.
# `amd64`/`arm64` is Docker's spelling; Rust and gcc each have their own.
ARG BUILDARCH
ARG TARGETARCH

# A toolchain for the foreign architecture, and only then.
#
# Both parts are needed: the compiler and the target's libc headers. Without
# `libc6-dev-*-cross` gcc is present and `#include <stdlib.h>` is not, which
# surfaces as a C error inside a dependency rather than anything about
# cross-compiling.
#
# Conditional because Debian's own gcc already provides the triplet-prefixed
# name for the native architecture, and the `-cross` libc for the architecture
# in use conflicts with the real one.
RUN if [ "$BUILDARCH" != "$TARGETARCH" ]; then \
        apt-get update && case "$TARGETARCH" in \
            amd64) apt-get install -y --no-install-recommends \
                       gcc-x86-64-linux-gnu libc6-dev-amd64-cross ;; \
            arm64) apt-get install -y --no-install-recommends \
                       gcc-aarch64-linux-gnu libc6-dev-arm64-cross ;; \
            *) echo "no cross toolchain known for $TARGETARCH" >&2; exit 1 ;; \
        esac && rm -rf /var/lib/apt/lists/*; \
    fi

# One place that knows the mapping, read by the steps after it.
RUN case "$TARGETARCH" in \
        amd64) echo x86_64-unknown-linux-gnu  > /target ;; \
        arm64) echo aarch64-unknown-linux-gnu > /target ;; \
        *) echo "no Rust target known for $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && rustup target add "$(cat /target)"

# Read per target by Cargo, so naming both leaves the native case untouched.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc
# And the C compiler, for the crates that build C: SQLite is bundled and ring
# compiles its own primitives. `cc` reads the target-suffixed form.
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc

# The whole workspace: the worker is one crate of several and the binary that
# runs is ft-cli.
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migrations ./migrations

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    # `--no-default-features` is what the `server` feature was written for and
    # what this image had never actually used: it was shipping the whole control
    # plane — axum, sqlx, the embedded web application — to a container whose
    # only job is to speak frames. 16M becomes 5.6M.
    #
    # `firetower-worker`, not `firetower`: a person's PATH may hold a `firetower`
    # that is the npm CLI, and the control plane has to name the one it means.
    cargo build --release -p ft-cli --no-default-features \
        --bin firetower-worker --target "$(cat /target)" \
    # Out of the cache mount, which does not survive the layer.
    && cp "target/$(cat /target)/release/firetower-worker" /firetower-worker

FROM debian:bookworm-slim

# Declared again: build arguments do not cross a stage boundary, and the steps
# below pick a Docker repository and a `just` release by architecture.
ARG TARGETARCH

# What a worker actually uses: git for repositories, tmux so agents outlive the
# connection, ca-certificates so it can reach a git host over https.
#
# `iptables` is Docker's, and here rather than left to the package because the
# daemon publishing a port into this container's own network namespace is what
# makes a preview reach a compose service at all.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git tmux ca-certificates curl iptables \
    && rm -rf /var/lib/apt/lists/*

# Node, for installing agents rather than for running Firetower.
#
# **No agent is in this image.** Each is a few hundred megabytes — Claude Code
# alone was half of what this used to weigh — and they are published on their
# own schedules, so baking them in meant a new Firetower release before
# anybody could use a new one, and a rebuild for every version.
#
# They are installed onto the volume instead, by `firetower-worker agents add`,
# which the CLI runs for you when you install a worker. The volume survives
# recreating this container, so upgrading the worker keeps them.
#
# npm is how both publishers actually ship: it resolves the right build for the
# architecture and hands over a digest with the tarball.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

# Docker, so a session can run the stack the repository actually runs on.
#
# **The largest thing in this image, by a lot.** The stage above is 5.6 MB of
# Rust on a slim base and everything else here is small; this is a few hundred
# megabytes of daemon, containerd, runc and two plugins. It is worth it because
# without it an agent cannot start the application it just changed — it can
# write code and run unit tests, and then has to say "this should work" rather
# than "I ran it". Most repositories worth pointing an agent at come up with
# `docker compose up`, and the difference between an agent that can do that and
# one that cannot is the difference between a suggestion and a verified change.
#
# The daemon, not only the client. A client with nothing to talk to is a worse
# failure than no client at all — see docker-entrypoint.sh for what starts it,
# and why it is pid 1's child rather than the worker's.
#
# **No images are baked in.** The layer cache is not the image cache: pulling
# `postgres` here would be paid by every worker on every release, and the
# volume at /var/lib/docker keeps them across upgrades instead.
#
# `$TARGETARCH` is Docker's own spelling — `amd64`/`arm64` — which is exactly
# what its apt repository indexes by, so this needs no mapping of its own.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
         -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$TARGETARCH signed-by=/etc/apt/keyrings/docker.asc] \
https://download.docker.com/linux/debian bookworm stable" \
         > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        docker-ce docker-ce-cli containerd.io \
        docker-buildx-plugin docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# What this repository's own documentation tells you to run, and what any
# repository pinned to pnpm needs.
#
# `just` is not in Debian, so it comes from its own release. `pnpm` refuses to
# be replaced by npm — a `web/` directory with a `pnpm-lock.yaml` is a hard
# requirement, not a preference — and the version is pinned so that what an
# agent gets does not change under it between releases of this image.
ARG JUST_VERSION=1.43.0
ARG PNPM_VERSION=10.20.0
RUN case "$TARGETARCH" in \
        amd64) just_arch=x86_64-unknown-linux-musl  ;; \
        arm64) just_arch=aarch64-unknown-linux-musl ;; \
        *) echo "no just release known for $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-${just_arch}.tar.gz" \
         | tar -xz -C /usr/local/bin just \
    && npm install -g "pnpm@${PNPM_VERSION}" \
    && npm cache clean --force

COPY --from=build /firetower-worker /usr/local/bin/firetower-worker

# Starts the Docker daemon, then hands over to whatever was asked for.
#
# An entrypoint rather than something the worker supervises, because the worker
# is not long-lived: `firetower-worker --stdio` is one process per control-plane
# connection and dies whenever that connection does. A daemon parented to it
# would take every running compose stack down on each reconnect — the exact
# thing tmux exists here to prevent.
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Where this worker keeps its mirrors, worktrees and event log.
RUN mkdir -p /var/lib/firetower/worker
VOLUME /var/lib/firetower

# Where the daemon keeps what it has pulled and built.
#
# Declared so that a container started without one gets an anonymous volume
# rather than writing a filesystem onto its own overlay — which is the classic
# way nested Docker fails, and fails confusingly. `container.rs` mounts a named
# one here so the cache survives the container being recreated to upgrade it.
RUN mkdir -p /var/lib/docker
VOLUME /var/lib/docker

# The agent's own directory, on the volume.
#
# Not for credentials: the token arrives per session in the frame that starts a
# workspace and is never written here. This holds what an agent accumulates by
# being used — first-run answers, caches — so recreating the container to
# upgrade it doesn't start from nothing.
ENV HOME=/var/lib/firetower/home
RUN mkdir -p "$HOME"

# A toolchain an agent installs for itself, findable in the session after.
#
# No Rust is in this image — rustup and a toolchain are about 1.5 GB, and most
# sessions never want one. But `$HOME` is on the volume, so an agent that runs
# `rustup` once has left something behind that outlives its session, and the
# only reason the next one could not use it was that this line was missing:
# cargo lands in `$HOME/.cargo/bin` and nothing ever looked there. The same
# holds for anything else installed into a home directory that persists.
#
# Last on the PATH, for the reason `runtime.rs` appends the agents' own
# directories: a copy the image or the machine provides is somebody's
# deliberate choice, and ours answers only when nothing else does.
ENV PATH=$PATH:/var/lib/firetower/home/.cargo/bin:/var/lib/firetower/home/.local/bin

# Readable without starting anything. The control plane compares it with its
# own and reports a drift.
ARG VERSION=0.0.0-dev
LABEL org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.title="Firetower worker" \
      org.opencontainers.image.source="https://github.com/firetower-cloud/firetower" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

# Nothing to serve: a caller runs `… worker --stdio` in here when it wants to.
# This only has to stay alive.
CMD ["sleep", "infinity"]
