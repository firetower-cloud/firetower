{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "firetower",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "Cargo.toml",
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": [
        "desktop",
        "mobile"
      ]
    },
    "desktop": {
      "release-type": "simple",
      "package-name": "firetower-desktop",
      "component": "desktop",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "src-tauri/Cargo.toml",
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        }
      ],
      "initial-version": "0.1.0"
    },
    "mobile": {
      "release-type": "simple",
      "package-name": "firetower-mobile",
      "component": "mobile",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        }
      ],
      "initial-version": "0.1.0"
    }
  }
}
