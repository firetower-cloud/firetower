/target
/api/openapi.json.tmp
node_modules
.next
# The static export. Built by `just build` and compiled into the binary, so
# nothing in it belongs in version control. The directory has to exist for
# ft-server to compile, and its build script creates it — a committed
# placeholder does not survive, because `next build` deletes this directory
# before writing it.
/web/out
.env
# ...but the template is the documentation of what can go in one.
!.env.example
*.db
*.db-shm
*.db-wal
.DS_Store

# The compose stack keeps its state here, including the key every stored
# credential is encrypted with. It must never be committed.
/.firetower
# The ssh key pair the dev worker container is reached with.
/.dev

/.claude-memory.md
# Worktrees and whatever else the assistant keeps. Committing the first would
# nest a git repository inside this one.
/.claude/
