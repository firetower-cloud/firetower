# Copy to .env and fill in. Firetower reads ./.env, then ~/.firetower/.env.
#
# Nothing here is a credential. Those go in the secret store, encrypted — so if
# you ever find yourself putting one here, something has gone wrong.

# Lets you authorize GitHub and pick from your repositories instead of pasting
# URLs. Register an OAuth application with the device flow enabled and paste its
# Client ID; the README walks through it.
#
# A device-flow client ID is public by design: there is no paired secret.
FIRETOWER_GITHUB_CLIENT_ID=

# The control plane's database. `just dev` starts one from compose.yaml;
# this is where to point it somewhere else.
# DATABASE_URL=postgres://firetower:firetower@localhost:5433/firetower

# What compose creates the database with.
# POSTGRES_USER=firetower
# POSTGRES_PASSWORD=firetower
# POSTGRES_DB=firetower
# POSTGRES_PORT=5433

# The key every stored credential is encrypted with, base64, 32 bytes.
#
# Set this and nothing is written to disk — which is what a container or a
# server wants. Leave it unset and Firetower keeps one at ~/.firetower/root.key,
# mode 0600, created on first run. Either way it lives outside the database, so
# a database backup on its own opens nothing.
#
# Losing it means adding every credential again. Back it up separately.
# FIRETOWER_ROOT_KEY=

# Where Firetower keeps its state. Defaults to ~/.firetower
# FIRETOWER_HOME=

# The port the control plane listens on. Defaults to 4400
# FIRETOWER_PORT=
