# Firetower, on a machine you own. Copy to `.env` beside firetower.yml.
#
# Everything here is something you have to decide. The contributors' file at
# the repository root is the opposite — every value in that one has a working
# default, because it is for people running from a checkout.

# Where Firetower will live.
#
# Point an A record at this machine first and check it with
# `dig +short firetower.example.com` — Caddy proves you own the name by
# answering on port 80, so both 80 and 443 have to be open to the internet.
#
# Leave it unset and Firetower serves plain HTTP on port 80, which is what you
# want when it is only ever reached from this machine.
DOMAIN=firetower.example.com

# The address you will open in a browser. Only used for the URL printed on the
# first start — Firetower listens on 4400 inside its container and cannot know
# what Caddy answers on.
#
# Set this to https://<your DOMAIN> when you set DOMAIN above. With no domain,
# the default is right.
# FIRETOWER_PUBLIC_URL=https://firetower.example.com

# The database password. Change it: this container is on a machine with a
# public address now.
#
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# The key every stored credential is sealed with, base64, 32 bytes.
#
#   openssl rand -base64 32
#
# Set it here and nothing is written to disk. Leave it empty and one is created
# on the volume, which works — and makes that volume as valuable as the
# database.
#
# Back it up somewhere that is not your database backup. That separation is the
# entire point: a stolen database opens nothing on its own. Losing the key means
# adding every credential again.
FIRETOWER_ROOT_KEY=

# Who may use this Firetower.
#
# Leave it empty and one is generated on the first start and printed in the log
# with a URL you can click:
#
#   docker compose -f firetower.yml logs firetower
#
# Set it to share one you already have, or to rotate: change it here, restart,
# and the old one stops working.
FIRETOWER_TOKEN=

# Optional: your own GitHub OAuth application, if you would rather not use
# ours. The README explains registering one — it is a five-minute job, and only
# needed if you want to pick from a list of your repositories instead of
# pasting URLs.
# FIRETOWER_GITHUB_CLIENT_ID=

# Optional: hand identity to a proxy that already authenticates — Cloudflare
# Access, Authelia, oauth2-proxy, Caddy's forward_auth. Firetower believes the
# header only from the addresses named here, and refuses to start if you set
# one without the other.
# FIRETOWER_TRUSTED_PROXY_HEADER=X-Forwarded-Email
# FIRETOWER_TRUSTED_PROXY=172.16.0.0/12

# Optional: the database's name and user, if the defaults bother you.
# POSTGRES_USER=firetower
# POSTGRES_DB=firetower
